{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomScenarioPreset",
  "version": "2.7.8",
  "type": "object",
  "properties": {
    "preset_id": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "preset_id"]
    },
    "drawers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "drawer_id": { "type": "string", "enum": ["metrics", "derivatives", "hamiltonians", "topological", "stochastic", "observables"] },
          "display_name": { "type": "string" },
          "color_accent": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": { "type": "string" },
          "operator_type": { "type": "string" },
          "drawer_id": { "type": "string" },
          "position_3d": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "inputs": {
            "type": "array",
            "items": { "$ref": "#/definitions/Socket" }
          },
          "outputs": {
            "type": "array",
            "items": { "$ref": "#/definitions/Socket" }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          }
        },
        "required": ["node_id", "operator_type", "inputs", "outputs"]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_node": { "type": "string" },
          "source_output": { "type": "string" },
          "target_node": { "type": "string" },
          "target_input": { "type": "string" }
        },
        "required": ["source_node", "source_output", "target_node", "target_input"]
      }
    },
    "slider_bindings": {
      "type": "object",
      "properties": {
        "coupling_strength": { "type": "string" },
        "entropy_perturbation": { "type": "string" },
        "stream_velocity": { "type": "string" },
        "scalar_distortion": { "type": "string" }
      }
    }
  },
  "definitions": {
    "Socket": {
      "type": "object",
      "properties": {
        "socket_id": { "type": "string" },
        "name": { "type": "string" },
        "rank": { "type": "integer", "minimum": 0, "maximum": 4 },
        "variance": { "type": "string", "enum": ["covariant", "contravariant", "scalar"] },
        "shape_marker": { "type": "string", "enum": ["circle", "triangle", "square", "hexagon"] }
      },
      "required": ["socket_id", "rank", "variance", "shape_marker"]
    }
  },
  "required": ["preset_id", "metadata", "nodes", "connections"]
}